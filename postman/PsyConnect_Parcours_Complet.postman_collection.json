        {
          "name": "Inscription d'un patient",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('ts', ts);",
                  "pm.collectionVariables.set('patientEmail', 'patient.' + ts + '@test.sn');",
                  "pm.collectionVariables.set('patientPseudo', 'patient' + ts);",
                  "pm.collectionVariables.set('psyEmail', 'psy.' + ts + '@test.sn');",
                  "pm.collectionVariables.set('psyPseudo', 'psy' + ts);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inscription du patient acceptée', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register/patient",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register",
                "patient"
              ]
