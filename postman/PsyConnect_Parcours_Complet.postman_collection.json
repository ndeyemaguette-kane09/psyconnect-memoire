    {
      "name": "2. Validation du psychologue",
      "item": [
        {
          "name": "(Refus) Réserver chez un psychologue non validé",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const fmt = (d) => { const p = (n) => String(n).padStart(2, '0'); return d.getFullYear() + '-' + p(d.getMonth()+1) + '-' + p(d.getDate()) + 'T' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':00'; };",
                  "const base = new Date(); base.setSeconds(0, 0); base.setMinutes(0);",
                  "const s = new Date(base.getTime() + 72 * 3600 * 1000), e = new Date(s.getTime() + 3600 * 1000);",
                  "const ss = new Date(base.getTime() + 60 * 60 * 1000), se = new Date(ss.getTime() + 3600 * 1000);",
                  "pm.collectionVariables.set('start', fmt(s)); pm.collectionVariables.set('end', fmt(e));",
                  "pm.collectionVariables.set('soonStart', fmt(ss)); pm.collectionVariables.set('soonEnd', fmt(se));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Réservation refusée (403)', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": {{patientProfileId}},\n  \"psychologistId\": {{psyProfileId}},\n  \"startTime\": \"{{start}}\",\n  \"endTime\": \"{{end}}\",\n  \"consultationType\": \"VIDEO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patientToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
