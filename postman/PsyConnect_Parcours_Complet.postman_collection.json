            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{password}}\",\n  \"pseudo\": \"{{patientPseudo}}\",\n  \"firstName\": \"Awa\",\n  \"lastName\": \"Diop\"\n}",
              "options": {
                "raw": {
                  "language": "json"
