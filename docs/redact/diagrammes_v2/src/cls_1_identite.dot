digraph G {
graph [rankdir=TB, fontname="DejaVu Sans", fontsize=10, nodesep=0.25, ranksep=0.45, splines=ortho, pad=0.05, newrank=true];
node [shape=plaintext, fontname="DejaVu Sans", fontsize=9, margin=0];
edge [fontname="DejaVu Sans", fontsize=8, arrowsize=0.7, color="#333333"];
subgraph cluster_0 { label=<<B>auth-service</B>>; labeljust=l; style="rounded,dashed"; color="#9AA7B8"; fontcolor="#2E4D8A"; margin=10;
"User" [label=<<TABLE BORDER="1" COLOR="#222222" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF6" BORDER="1" SIDES="B"><FONT POINT-SIZE="10"><B>User</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- email : String<BR ALIGN="LEFT"/>- password : String (haché)<BR ALIGN="LEFT"/>- role : Role<BR ALIGN="LEFT"/>- pseudo : String<BR ALIGN="LEFT"/>- firstName : String<BR ALIGN="LEFT"/>- lastName : String<BR ALIGN="LEFT"/>- enabled : boolean<BR ALIGN="LEFT"/>- createdAt : LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PasswordResetCode" [label=<<TABLE BORDER="1" COLOR="#222222" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF6" BORDER="1" SIDES="B"><FONT POINT-SIZE="10"><B>PasswordResetCode</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- userId : Long<BR ALIGN="LEFT"/>- codeHash : String<BR ALIGN="LEFT"/>- expiresAt : LocalDateTime<BR ALIGN="LEFT"/>- used : boolean<BR ALIGN="LEFT"/>- attempts : int<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
subgraph cluster_1 { label=<<B>user-service</B>>; labeljust=l; style="rounded,dashed"; color="#9AA7B8"; fontcolor="#2E4D8A"; margin=10;
"UserProfile" [label=<<TABLE BORDER="1" COLOR="#222222" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF6" BORDER="1" SIDES="B"><FONT POINT-SIZE="10"><B>UserProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- authUserId : Long<BR ALIGN="LEFT"/>- firstName : String<BR ALIGN="LEFT"/>- lastName : String<BR ALIGN="LEFT"/>- phoneNumber : String<BR ALIGN="LEFT"/>- gender : String<BR ALIGN="LEFT"/>- dateOfBirth : LocalDate<BR ALIGN="LEFT"/>- address, city, country : String<BR ALIGN="LEFT"/>- profilePicture : String<BR ALIGN="LEFT"/>- profileCompleted : Boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PatientProfile" [label=<<TABLE BORDER="1" COLOR="#222222" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF6" BORDER="1" SIDES="B"><FONT POINT-SIZE="10"><B>PatientProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- authUserId : Long<BR ALIGN="LEFT"/>- anonymousMode : Boolean<BR ALIGN="LEFT"/>- emergencyContactName : String<BR ALIGN="LEFT"/>- emergencyContactPhone : String<BR ALIGN="LEFT"/>- preferredLanguage : String<BR ALIGN="LEFT"/>- walletBalance : Double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PsychologistProfile" [label=<<TABLE BORDER="1" COLOR="#222222" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF6" BORDER="1" SIDES="B"><FONT POINT-SIZE="10"><B>PsychologistProfile</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- authUserId : Long<BR ALIGN="LEFT"/>- specialty : String<BR ALIGN="LEFT"/>- bio : String<BR ALIGN="LEFT"/>- languages : String<BR ALIGN="LEFT"/>- yearsOfExperience : Integer<BR ALIGN="LEFT"/>- licenseNumber : String<BR ALIGN="LEFT"/>- licenseDocumentPath : String<BR ALIGN="LEFT"/>- consultationPrice : Integer<BR ALIGN="LEFT"/>- address, city : String<BR ALIGN="LEFT"/>- rating : Double<BR ALIGN="LEFT"/>- totalReviews : int<BR ALIGN="LEFT"/>- profileVerified : Boolean<BR ALIGN="LEFT"/>- rejected : Boolean<BR ALIGN="LEFT"/>- available : Boolean<BR ALIGN="LEFT"/>- availableForEmergency : Boolean<BR ALIGN="LEFT"/>- offersFreeSessions : Boolean<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
"PsychologistAvailability" [label=<<TABLE BORDER="1" COLOR="#222222" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#E8EEF6" BORDER="1" SIDES="B"><FONT POINT-SIZE="10"><B>PsychologistAvailability</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id : Long<BR ALIGN="LEFT"/>- psychologistProfileId : Long<BR ALIGN="LEFT"/>- dayOfWeek : Integer<BR ALIGN="LEFT"/>- startHour : Integer<BR ALIGN="LEFT"/>- endHour : Integer<BR ALIGN="LEFT"/>- slotDurationMinutes : Integer<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
}
"User" -> "UserProfile" [style=dashed, dir=back, arrowtail=vee, taillabel=" 1 ", headlabel=" 1 ", xlabel=" authUserId ", labeldistance=1.6];
"UserProfile" -> "PatientProfile" [dir=none, taillabel=" 1 ", headlabel=" 0..1 ", labeldistance=1.6];
"UserProfile" -> "PsychologistProfile" [dir=none, taillabel=" 1 ", headlabel=" 0..1 ", labeldistance=1.6];
"PsychologistProfile" -> "PsychologistAvailability" [dir=none, taillabel=" 1 ", headlabel=" 0..* ", labeldistance=1.6];
"User" -> "PasswordResetCode" [style=dashed, dir=back, arrowtail=vee, taillabel=" 1 ", headlabel=" 0..* ", xlabel=" userId ", labeldistance=1.6];
{rank=same; "User"; "UserProfile";}
}